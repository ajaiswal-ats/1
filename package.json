{
  "name": "client-portal-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "assessment-preview:build": "vite build --config vite.preview.config.mjs && node scripts/preview/export-data.mjs",
    "assessment-preview:serve": "vite preview --config vite.preview.config.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "compare:shell": "node scripts/compare-shell.mjs",
    "compare:progress": "node scripts/compare-progress.mjs",
    "compare:candidates": "node scripts/compare-candidates.mjs",
    "compare:candidate": "node scripts/compare-candidate.mjs",
    "compare:roles": "node scripts/compare-roles.mjs",
    "check:persistence": "node scripts/check-persistence.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:recruiter": "node scripts/recruiter/check-ui.mjs",
    "recruiter:preview": "vite --config vite.recruiter-preview.config.mjs",
    "db:verify": "node scripts/db/verify-project.mjs",
    "db:apply": "node scripts/db/apply.mjs",
    "db:rollback": "node scripts/db/rollback.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:seed:generate": "node scripts/db/gen-seed.mjs",
    "db:seed:generate:m3": "node scripts/db/gen-seed-m3.mjs",
    "db:seed:generate:m4": "node scripts/db/gen-seed-m4.mjs",
    "db:seed:generate:m6": "node scripts/db/gen-seed-m6.mjs",
    "db:users": "node scripts/db/users.mjs",
    "db:test:sql": "node scripts/db/test-sql.mjs",
    "db:test:api": "vitest run --config vitest.db.config.mjs",
    "db:api:read": "node scripts/db/api-read.mjs",
    "db:api:moves": "node scripts/db/api-moves.mjs",
    "db:ui-moves:restore-sql": "node scripts/db/ui-moves-restore.mjs",
    "db:test:offline": "vitest run --config vitest.offline-db.config.mjs",
    "db:check-secrets": "node scripts/db/check-no-secrets.mjs",
    "scoring:dev": "vite --config vite.scoring.config.mjs",
    "scoring:dev:ai": "SCORING_AI_ROUTE=claude-cli SCORING_AI_MODEL=sonnet SCORING_AI_MAX_USD=1 SCORING_AI_TIMEOUT_MS=600000 vite --config vite.scoring.config.mjs",
    "scoring:check": "node scripts/scoring/check-isolation.mjs",
    "scoring:run": "node scripts/scoring/run-assessments.mjs",
    "scoring:eval-pack": "node scripts/scoring/evaluation-pack.mjs",
    "scoring:check-migration": "node scripts/scoring/check-migration.mjs",
    "extract": "node scripts/extract/cli.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
