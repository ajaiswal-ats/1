# Copy to supabase/.env.dev.local (gitignored) and fill in locally. Never paste these values into chat.
# None of these names start with VITE_, so Vite never exposes them to browser code. The scripts refuse to run if one does.

# Project URL, from the Supabase dashboard: Project Settings > Data API. Public.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public client key (the "anon" or "publishable" key). Safe for browsers, but keep it out of chat.
SUPABASE_ANON_KEY=

# PRIVILEGED. Postgres connection string from Connect > Session pooler (works without the paid IPv4 add-on).
# Used only by the scripts in scripts/db to check, migrate, seed and test the development database.
# Example shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# PRIVILEGED. Service role / secret key, used only to create and delete the four fictional test users.
# LEAVE EMPTY until test-user creation is approved. npm run db:verify does not read it.
SUPABASE_SERVICE_ROLE_KEY=
