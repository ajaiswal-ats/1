# Browser settings for the portal. Copy to .env.local (gitignored) and restart `npm run dev`.
# Everything prefixed VITE_ is built into the browser bundle, so only PUBLIC values belong here.
# Without this file, or with VITE_PORTAL_MODE=demo, the portal runs the fictional demo exactly as reviewed.

# demo (default) or supabase. A misconfigured supabase mode shows an error; it never falls back to the demo.
VITE_PORTAL_MODE=demo

# Supabase mode only: the project URL (Project Settings > Data API), without /rest/v1.
VITE_SUPABASE_URL=

# Supabase mode only: the PUBLIC key (publishable sb_publishable_…, or the legacy anon key). Never a secret key.
VITE_SUPABASE_ANON_KEY=
